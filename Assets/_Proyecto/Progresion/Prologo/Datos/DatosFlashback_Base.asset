  m_Name: DatosFlashback_Base
  m_EditorClassIdentifier: MechaCyberpunk.Progresion.Prologo::MechaCyberpunk.Progresion.Prologo.DatosFlashback
  planos:
  - idPunto: Flashback_Plano_1
    segundos: 9
    subtitulo: "Ten\xEDas ocho a\xF1os la \xFAltima vez que los viste."
  - idPunto: Flashback_Plano_2
    segundos: 9
    subtitulo: "Mam\xE1 le dio una vuelta m\xE1s a cada tornillo del mecha."
  - idPunto: Flashback_Plano_3
    segundos: 9
    subtitulo: "Pap\xE1 dijo que volver\xEDan antes de que amaneciera."
  - idPunto: Flashback_Plano_4
    segundos: 10
    subtitulo: "Se fueron en una camioneta sin placas, con un logo que no conoc\xEDas."
  - idPunto: Flashback_Plano_5
    segundos: 8
    subtitulo: No volvieron.
  - idPunto: Flashback_Plano_6
    segundos: 10
    subtitulo: "Solo qued\xF3 el mecha. Y las preguntas."
  segundosFundido: 0.5
  textoSalto: "Mant\xE9n ESPACIO para saltar"
  segundosParaSaltar: 1
